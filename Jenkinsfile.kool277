// kool277 pipeline for kool277/jami-daemon (multibranch job from
// ci/jenkins/setup.sh in kool277/jami). The build scripts live in the
// workspace repository kool277/jami: each build fetches it (outside the
// checkout, into $WORKSPACE_TMP/kool277) for a v* release tag at the
// platform release named in the tag message, else main. Builds reuse build/
// and the contrib tree of the previous build in this Jenkins workspace.
//
// Every build: configure and build in the ci/daemon container, smoke tests,
// jamid on D-Bus. On a v* tag: package and publish the GitHub release
// (see RELEASING.md in kool277/jami). Needs the github-kool277 credential,
// docker and /var/cache/jami on the agent.

// The kool277/jami ref to build with: for a v* release tag, the platform
// release that made it, from the "Platform:" line of the tag message (see
// ci/release/platform-release.sh in kool277/jami); else main. Call it after
// the checkout.
def ciRef() {
    if (!env.TAG_NAME?.startsWith('v')) {
        return 'main'
    }
    def platform = sh(returnStdout: true,
                      script: 'git for-each-ref --format="%(contents)" "refs/tags/$TAG_NAME" | sed -n "s/^Platform: //p"').trim()
    if (!platform) {
        error("The message of tag ${env.TAG_NAME} names no platform release (no Platform: line)")
    }
    return platform
}

// Run a network step up to 10 times, 30 s apart: this agent's connection
// drops for minutes at a time.
def withNetRetry(Closure body) {
    def attempt = 0
    retry(10) {
        if (attempt++ > 0) {
            sleep(time: 30, unit: 'SECONDS')
        }
        body()
    }
}

pipeline {
    agent any
    options {
        timestamps()
        ansiColor('xterm')
        timeout(time: 3, unit: 'HOURS')
        disableConcurrentBuilds()
        // Checked out in the first stage, with withNetRetry.
        skipDefaultCheckout()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    environment {
        KOOL277 = "${env.WORKSPACE_TMP}/kool277"
        CI = "${env.WORKSPACE_TMP}/kool277/ci"
        DAEMON_DIR = "${env.WORKSPACE}"
    }
    stages {
        stage('Sources') {
            steps {
                withNetRetry {
                    checkout scm
                }
                script {
                    env.CI_REF = ciRef()
                }
                withNetRetry {
                    sh 'rm -rf "$KOOL277" && git clone -q --depth 1 --branch "$CI_REF" https://github.com/kool277/jami.git "$KOOL277"'
                }
            }
        }
        stage('Build') {
            steps {
                sh 'JOBS=$(nproc) "$CI/daemon/run.sh"'
            }
        }
        stage('Test') {
            steps {
                sh '''"$CI/daemon/run.sh" ctest --test-dir build --output-on-failure \
                        -R '^(base64|string_utils|utf8_utils|fileutils|socket_pair_mux|dtls_srtp_transport|webrtc_sdp|web_call_signaling|web_call_delivery|webrtc_call)$' \
                        --output-junit /src/jami-daemon/build/ctest-smoke.xml'''
                sh '"$CI/daemon/run.sh" dbus-run-session -- sh /ci/dbus-check.sh'
            }
            post {
                always { junit allowEmptyResults: true, testResults: 'build/ctest-smoke.xml' }
            }
        }
        stage('Release') {
            when { tag 'v*' }
            steps {
                sh 'VERSION="$TAG_NAME" DOCKER_RUN_ARGS="-e VERSION" "$CI/daemon/run.sh" sh /ci/package.sh'
                archiveArtifacts artifacts: 'build/dist/*', fingerprint: true
                withCredentials([usernamePassword(credentialsId: 'github-kool277',
                                                  usernameVariable: 'GH_USER',
                                                  passwordVariable: 'GH_TOKEN')]) {
                    withNetRetry {
                        sh 'PLATFORM="$CI_REF" "$CI/release/publish-release.sh" jami-daemon "$TAG_NAME" build/dist/*'
                    }
                }
            }
        }
    }
    post {
        // A v* tag is built once, for a release: free its workspace,
        // several GB with the contrib build, when the build ends. Branch
        // and pull request builds keep theirs to build incrementally.
        cleanup {
            script {
                if (env.TAG_NAME?.startsWith('v')) {
                    cleanWs(notFailBuild: true)
                }
            }
        }
    }
}
